# ============================================================
#  monitoring-frontend — contoh konfigurasi environment
#  Salin file ini menjadi .env lalu isi nilainya.
#  JANGAN commit file .env yang berisi nilai asli.
# ============================================================

# URL project Supabase (milik pemilik aplikasi, SATU project untuk semua user).
# Dashboard Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key. WAJIB pakai "anon" — JANGAN "service_role".
# Anon key aman dipakai di browser karena dilindungi RLS.
# Dashboard Supabase -> Project Settings -> API -> anon public
VITE_SUPABASE_ANON_KEY=your-anon-key

# CATATAN:
# - Semua variabel HARUS ber-prefix VITE_ agar terbaca oleh Vite (import.meta.env).
# - Di Vercel, set kedua variabel ini di:
#     Project -> Settings -> Environment Variables (Production + Preview)
#   Variabel di-set saat BUILD, jadi setelah mengubahnya harus redeploy.
